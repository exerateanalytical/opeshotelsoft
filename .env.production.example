# OpesHotelSoft — production environment template.
# Copy to .env, then replace every CHANGE_ME. Never commit the real file.
# Generate APP_KEY with:  php artisan key:generate --show
# Generate other secrets: openssl rand -base64 48

APP_NAME="OpesHotelSoft"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hotel.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=cache
# Demo one-click logins must stay off in production (refused when APP_ENV=production unless
# ALLOW_DEMO_LOGINS_IN_PRODUCTION=true, which you should never set on a hotel with real data).
DEMO_LOGINS=false
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs or CIDR). Empty: none.
# Bare metal with Caddy/nginx on the same host: 127.0.0.1. docker-compose.yml sets the Docker ranges itself.
TRUSTED_PROXIES=127.0.0.1
BCRYPT_ROUNDS=12

# Logging: "json" = daily JSON-lines file in storage/logs; "stderr_json" for containers/journald.
LOG_CHANNEL=json
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=opeshotelsoft
DB_USERNAME=opes
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=opes_
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Passport keys (alternative to storage/oauth-*.key files). Multi-line PEM in quotes.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

# --- Health endpoint (/health) ---
# Optional: send as X-Health-Token to get numbers (latency, backlog, free disk).
OPS_HEALTH_TOKEN=
OPS_HEALTH_QUEUE_BACKLOG_MAX=500
OPS_HEALTH_FAILED_JOBS_MAX=50
OPS_HEALTH_DISK_MIN_FREE_MB=2048
# OPS_HEALTH_REDIS=true

# --- Backups (ops:backup / ops:backup:verify) ---
# Separate passphrase strongly recommended (if empty, APP_KEY is used). Store a copy OFF the server:
# without it, backups cannot be decrypted.
BACKUP_KEY=CHANGE_ME
BACKUP_PATH=/var/backups/opeshotelsoft
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_AT=01:30
# Optional off-site copy to an S3-compatible disk (requires league/flysystem-aws-s3-v3).
BACKUP_DISK=
BACKUP_DISK_PREFIX=db-backups
# PG_BIN_PATH=/usr/lib/postgresql/16/bin

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
